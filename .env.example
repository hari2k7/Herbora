# Copy this file to .env.local for local testing, and add the same two values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit the real values.

# Shop WhatsApp number: country code + number, digits only
WHATSAPP_PHONE=91XXXXXXXXXX

# The API key CallMeBot sends you on WhatsApp after you activate it
CALLMEBOT_APIKEY=
